# Copy to .env.opening for opening:verify. Provision these independently of the public API.
CUSTODY_PROVIDER=vault
VAULT_ADDR=https://vault.example.gov
VAULT_TRANSIT_MOUNT=transit
VAULT_TOKEN_FILE=/run/secrets/constructblock-vault-token
VAULT_KEY_MANIFEST=/etc/constructblock/vault-key-manifest.json
# External trusted signer must expose eth_accounts, personal_sign, eth_sendTransaction,
# nonce/receipt/network and other ethers-required Ethereum RPC methods for the service wallet.
OPENING_SIGNER_RPC_URL=https://signer.internal.example.gov
STORAGE_API_URL=https://constructblock.example.gov
