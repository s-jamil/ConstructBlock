# Copy to .env.documents. Used only by documents:dev/documents:start, never public API.
DOCUMENT_PORT=3002
DOCUMENT_ORIGIN=http://127.0.0.1:5173
DOCUMENT_AUDIT_DIR=document-audit
# Local demonstration only. Set the existing keys:generate directory, do not generate new keys for an old tender.
CUSTODY_PROVIDER=local
CUSTODY_DIR=/ABSOLUTE/PATH/TO/EXISTING/CUSTODY_DIRECTORY
# Production alternative: remove CUSTODY_DIR, set CUSTODY_PROVIDER=vault and NODE_ENV=production.
# DOCUMENT_ORIGIN=https://constructblock.example.gov
# VAULT_ADDR=https://vault.example.gov
# VAULT_TRANSIT_MOUNT=transit
# VAULT_TOKEN_FILE=/run/secrets/constructblock-vault-token
# VAULT_KEY_MANIFEST=/etc/constructblock/vault-key-manifest.json
