PORT=3001
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
RPC_TIMEOUT_MS=5000
# Public addresses from your deploy:local output. Update after redeployment/node reset.
ROLE_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
PROCUREMENT_WORKFLOW_ADDRESS=0x2279B7A0a67DB372996a5FaB50D91eAA73d2eBe6

# Persistent encrypted objects and public-only SPKI keys, relative to backend cwd.
# Keep private opening keys outside both directories.
STORAGE_DIR=storage
OPENING_KEYS_DIR=opening-keys

# Explicit storage selection. No automatic fallback when OrbitDB is unavailable.
STORAGE_PROVIDER=filesystem
# Set STORAGE_PROVIDER=orbitdb after installing/starting/importing the database.
ORBITDB_DIR=orbitdb-data
# Optional absolute Unix socket path; both services must use the same path.
# ORBITDB_SOCKET=/absolute/path/to/backend/orbitdb-data/storage.sock
